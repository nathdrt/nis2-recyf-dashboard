# === Connecteur GLPI ===
# URL de l'instance GLPI (sans slash final)
GLPI_URL=http://192.168.1.105

# App-Token : identifie l'application cliente auprès de l'API GLPI
# Généré par le script setup_glpi_connector.sh sur le conteneur
GLPI_APP_TOKEN=

# User Token : identifie le compte connecteur-api
# Généré par le script setup_glpi_connector.sh sur le conteneur
GLPI_USER_TOKEN=

# Fichier de sortie de l'inventaire (chemin relatif ou absolu)
OUTPUT_FILE=inventaire.json

# === Connecteur Wazuh ===
# URL de l'API Wazuh Manager (port 55000, TLS auto-signé)
WAZUH_URL=https://<ip-wazuh>:55000

# Compte dédié lecture seule, rôle agents_readonly
# Créé via l'API Wazuh (voir README pour la procédure)
WAZUH_USER=connecteur-api
WAZUH_PASSWORD=

# Fichier de sortie des agents (chemin relatif ou absolu)
WAZUH_OUTPUT_FILE=agents_wazuh.json

# === Connecteur Wazuh — Alertes (OpenSearch/Indexer, port 9200) ===
# URL de l'Indexer Wazuh (différent de l'API Manager port 55000)
WAZUH_INDEXER_URL=https://<ip-wazuh>:9200

# Compte OpenSearch avec rôle readall (lecture seule sur tous les indices)
# Créé automatiquement par l'installateur Wazuh, mot de passe dans wazuh-install-files.tar
WAZUH_INDEXER_USER=readall
WAZUH_INDEXER_PASSWORD=

# Fenêtre temporelle en heures (défaut : 24h)
WAZUH_ALERTES_FENETRE_HEURES=24

# Fichier de sortie du résumé d'alertes (chemin relatif ou absolu)
WAZUH_ALERTES_OUTPUT=alertes_wazuh.json

# Si OpenSearch n'écoute que sur localhost (cas typique Wazuh), définir l'alias SSH
# du serveur Wazuh pour créer un tunnel automatique. Laisser vide si accès direct.
WAZUH_INDEXER_SSH_HOST=wazuh
